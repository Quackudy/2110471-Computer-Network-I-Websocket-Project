# ==============================================================================
# Relay Server Configuration
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Port for the Python web/WebSocket server (default: 8080)
PORT=8080

# Allowed Origin header for WebSocket connection CSRF protection (leave blank for local dev)
# Example: https://relay.161.118.238.148.sslip.io
PUBLIC_ORIGIN=

# Ollama AI Inference Service URL (default: http://localhost:11434)
# When running inside Docker Compose, this should be http://ollama:11434
OLLAMA_URL=http://localhost:11434

# AI Model for chat summarization (default: qwen2.5:0.5b)
AI_MODEL=qwen2.5:0.5b

# ==============================================================================
# Docker & Deployment Configuration (Optional)
# ==============================================================================

# Published host port for Docker Compose (default: 8080)
APP_PORT=8080

# Domain name used by Traefik reverse proxy in Oracle Cloud deployment
APP_DOMAIN=relay.161.118.238.148.sslip.io

# Docker image tag for deployment
APP_IMAGE=relay:local
